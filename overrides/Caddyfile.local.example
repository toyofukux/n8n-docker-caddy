# Replace <domain>.<suffix>
n8n.<domain>.<suffix> {
  encode zstd gzip
  route {
    #handle_path /mcp/notion* {
    #  reverse_proxy http://notion-mcp:3000 {
    #    header_up Authorization {>Authorization}
    #    flush_interval 100ms
    #  }
    #}

    handle {
      reverse_proxy n8n:5678 {
        flush_interval -1
      }
    }
  }
}
