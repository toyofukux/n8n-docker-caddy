services:
  n8n:
    build:
      context: ./overrides
      dockerfile: Dockerfile.n8n-custom
      args:
        N8N_TAG: ${N8N_TAG:-1.111.0}
    environment:
      - N8N_ENABLE_EXTERNAL_MODULES=true
      #- NODE_FUNCTION_ALLOW_EXTERNAL=yahoo-finance2
      - N8N_PROXY_HOPS=1
  caddy:
    volumes:
      - caddy_data:/data
      - ${DATA_FOLDER}/caddy_config:/config
      - ${PWD}/overrides/Caddyfile.local:/etc/caddy/Caddyfile:ro

  notion-mcp:
    image: mcp/notion:latest
    restart: unless-stopped
    command: ["notion-mcp-server","--transport","http","--port","3000"]
    environment:
      # Notion integration token
      - NOTION_TOKEN=${NOTION_TOKEN}
      # from n8n to notion-mcp token
      - AUTH_TOKEN=${N8N_NOTION_AUTH_TOKEN}
    expose:
      - "3000"
    healthcheck:
      test: ["CMD-SHELL", "node -e \"require('http').get('http://localhost:3000/health', r => process.exit(r.statusCode===200?0:1)).on('error', () => process.exit(1))\""]
      interval: 10s
      timeout: 3s
      retries: 10
      start_period: 5s